# SQLite database file (relative to project root)
DATABASE_URL="file:./dev.db"

# Anthropic API key — required for summarization/classification
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for summarize+classify (default: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Path to the yt-dlp binary. Omit to rely on PATH.
YT_DLP_PATH=yt-dlp

# Slack bot token (xoxb-...) and signing secret — required for the Slack
# link intake integration. See README "Slack 整合設定" for setup steps.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Restrict Slack link intake to this channel ID (e.g. C0123456789).
# Leave blank to process messages from any channel the bot is in.
SLACK_CHANNEL_ID=

# Public base URL of this deployed app, used to build "查看詳情" links in
# Slack replies. Leave blank to omit the link.
APP_URL=

# Path to the saved Facebook Playwright session (see README "Facebook 內容
# 擷取" — experimental, opt-in, uses your own logged-in session). Leave the
# default; Facebook extraction is simply skipped if this file doesn't exist.
FACEBOOK_SESSION_PATH=./facebook-session.json

# Gemini API key — optional, enables reading actual video content (visuals +
# audio) for YouTube/TikTok when yt-dlp can't get usable captions. Get one at
# https://aistudio.google.com/apikey. Leave blank to skip this entirely; see
# README "🎬 影片內容理解".
GEMINI_API_KEY=

# Gemini model to use for video understanding (default: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
